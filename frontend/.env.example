# Google Maps JavaScript API key (enables the map-based shop location picker).
# Create one at https://console.cloud.google.com/google/maps-apis
# Enable "Maps JavaScript API" and "Geocoding API" for the key.
VITE_GOOGLE_MAPS_API_KEY=

# Announcement store configuration
VITE_ANNOUNCEMENTS_STORAGE_KEY=mutiaraconnect.announcements.v2
VITE_ANNOUNCEMENTS_READ_STORAGE_KEY=mutiaraconnect.announcements.read
VITE_ANNOUNCEMENTS_EVENT=mutiaraconnect:announcements-changed

# OpenRouteService API key (free): plans routes to shops that avoid closed roads.
# Sign up at https://openrouteservice.org/dev/#/signup and copy the default key.
VITE_ORS_API_KEY=
